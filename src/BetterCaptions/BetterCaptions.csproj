<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      App icon: a multi-resolution .ico (16/24/32/48/64/128/256) that the built exe
      carries, so the taskbar, Alt-Tab and every WPF window title bar show the real
      icon. It is ALSO embedded as a resource so the tray icon can load the exact
      small-size frame at runtime instead of a scaled placeholder.
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>BetterCaptions</AssemblyName>
    <!--
      WFO0003 is a WinForms analyzer rule asking for "ApplicationHighDpiMode" instead of
      manifest DPI settings. It is a false positive here: this is a WPF app, and WPF reads
      its DPI awareness (PerMonitorV2) from the manifest. WinForms is referenced ONLY for
      NotifyIcon, so the WinForms DPI API is not applicable.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>BetterCaptions</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Audio capture (WASAPI loopback) and the biquad high-pass used by the directional
      audio analyzer. NAudio 3.1.0 targets net9.0 and is clean on net10.0-windows.
    -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (logical name BetterCaptions.Assets.app.ico) so the tray icon can load
         a specific frame size; the ApplicationIcon above only sets the exe's Win32 icon. -->
    <None Remove="Assets\app.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
