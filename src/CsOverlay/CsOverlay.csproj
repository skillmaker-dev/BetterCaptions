<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CsOverlay</AssemblyName>
    <!--
      WFO0003 is a WinForms analyzer rule asking for "ApplicationHighDpiMode" instead of
      manifest DPI settings. It is a false positive here: this is a WPF app, and WPF reads
      its DPI awareness (PerMonitorV2) from the manifest. WinForms is referenced ONLY for
      NotifyIcon, so the WinForms DPI API is not applicable.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>CsOverlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Audio capture (WASAPI loopback) and the biquad high-pass used by the directional
      audio analyzer. NAudio 3.1.0 targets net9.0 and is clean on net10.0-windows.
    -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

</Project>
