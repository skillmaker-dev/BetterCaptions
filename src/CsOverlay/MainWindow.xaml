<Window x:Class="CsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CsOverlay"
        Width="320"
        Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Caption typography. Two tiers only: the newest line is emphasised and
             the one line before it uses the quieter history style. Only those two
             are ever rendered (see MaxRenderedCaptionLines in code-behind). All
             lines wrap to the panel width. -->
        <Style x:Key="CaptionBase" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- Pin the line box to LineHeight exactly. Under the default MaxHeight
                 strategy a line can render slightly taller than LineHeight, which
                 would make the two-bar content taller than the computed panel height
                 and leave the bars clipped. -->
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <!-- Each line paints its OWN fitted bar: the element's size is the text
                 plus this padding, so the bar width is scoped to its own line. The
                 vertical padding is deliberately small (2) so the bar hugs the glyphs. -->
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Padding" Value="10,2" />
            <!-- Centred within the vertical stack, so a shorter line sits centred
                 under a longer one (a long bar on top of a short bar). -->
            <Setter Property="HorizontalAlignment" Value="Center" />
            <!-- No per-line margin: the bars must sit flush, one directly on top of
                 the other (a margin here would render as a visible gap between them). -->
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- Newest / still-being-spoken line. -->
        <Style x:Key="CaptionNewest" TargetType="TextBlock" BasedOn="{StaticResource CaptionBase}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="26" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- The one older line. -->
        <Style x:Key="CaptionOlder" TargetType="TextBlock" BasedOn="{StaticResource CaptionBase}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="#BFFFFFFF" />
        </Style>

        <!-- The same fitted-bar treatment for the no-caption hint and the footer, so
             that with the transparent container no text floats unbacked over the game. -->
        <Style x:Key="StatusBar" TargetType="TextBlock">
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Hover-only "center" checkbox, kept small and raw to match the slab. -->
        <Style x:Key="CenterToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#BFFFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="12" Height="12"
                                    CornerRadius="2"
                                    Background="#14FFFFFF"
                                    BorderBrush="#59FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="CheckMark"
                                      Data="M2.5,6.5 L5,9 L9.5,3.5"
                                      Stroke="#FFFFFFFF"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The container is visually transparent - each caption line paints its own
         fitted #8C000000 bar instead. A Transparent brush paints nothing but stays
         hit-testable, which is what keeps the panel draggable.
         Neither Width nor Height is set: the slab auto-sizes to its content. Width is
         bounded by MinWidth/MaxWidth and height floored by MinHeight (the two-single-
         row size), both applied in code. Height being auto is what lets the panel GROW
         when a caption line wraps, instead of clipping the overflow at the top. -->
    <Border x:Name="OverlayPanel"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseLeftButtonDown="OverlayPanel_MouseLeftButtonDown"
            MouseMove="OverlayPanel_MouseMove"
            MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp"
            MouseEnter="OverlayPanel_MouseEnter"
            MouseLeave="OverlayPanel_MouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- No padding: each line carries its own, so the group width is exactly
                 the widest bar and no bar edge is clipped. -->
            <Border x:Name="CaptionArea"
                    Grid.Row="0"
                    Padding="0">
                <Grid ClipToBounds="True">
                    <!-- At most two lines are added here (oldest of the two first),
                         bottom-aligned, so the newest sits at the bottom. The panel's
                         MinHeight reserves two single rows, so nothing shifts when the
                         second line arrives; if a line wraps, the auto height lets the
                         panel grow rather than clipping the overflow. -->
                    <StackPanel x:Name="CaptionLinesPanel"
                                VerticalAlignment="Bottom" />

                    <!-- Quiet hint for the no-caption states. -->
                    <TextBlock x:Name="CaptionStatusText"
                               Style="{StaticResource StatusBar}"
                               Text="Live captions starting..."
                               Foreground="#80FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Only shown while there are no captions, so the panel is pure caption
                 content in use. -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Style="{StaticResource StatusBar}"
                       Text="waiting for game..."
                       Foreground="#66FFFFFF"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,6"
                       TextTrimming="CharacterEllipsis" />

            <!-- Resize grips. Hidden until the panel is hovered (faded in/out from
                 code-behind). Only the right edge and the bottom-right corner remain;
                 both adjust the max-width cap, since the height is now fixed by the
                 two-line content. Each is a plain transparent hit area with a small
                 mark. -->
            <Grid x:Name="ResizeGrips"
                  Grid.RowSpan="2"
                  Opacity="0"
                  IsHitTestVisible="False">

                <Grid x:Name="GripRight"
                      Width="8"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      Cursor="SizeWE"
                      MouseLeftButtonDown="GripRight_MouseLeftButtonDown"
                      MouseMove="Grip_MouseMove"
                      MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                    <Rectangle Width="2" Height="26"
                               RadiusX="1" RadiusY="1"
                               Fill="#4DFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid x:Name="GripCorner"
                      Width="18"
                      Height="18"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Background="Transparent"
                      Cursor="SizeNWSE"
                      MouseLeftButtonDown="GripCorner_MouseLeftButtonDown"
                      MouseMove="Grip_MouseMove"
                      MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                    <Path Data="M0,12 L12,0 M4,12 L12,4 M8,12 L12,8"
                          Stroke="#4DFFFFFF"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Hover-only overlay controls. This lives in a Canvas on purpose: a
                 Canvas ignores its children when computing its own desired size, so
                 the checkbox contributes ZERO to the slab's desired width and can
                 never widen the auto-fit slab. The inner Grid is width/height bound
                 to the panel purely so the checkbox can sit at the top-right corner
                 as the slab's width changes. -->
            <Canvas x:Name="OverlayControls"
                    Grid.RowSpan="2"
                    Opacity="0"
                    IsHitTestVisible="False">
                <Grid Width="{Binding ActualWidth, ElementName=OverlayPanel}"
                      Height="{Binding ActualHeight, ElementName=OverlayPanel}">
                    <CheckBox x:Name="CenterToggle"
                              Style="{StaticResource CenterToggleStyle}"
                              Content="center"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,6,12,0"
                              Checked="CenterToggle_Changed"
                              Unchecked="CenterToggle_Changed" />
                </Grid>
            </Canvas>
        </Grid>
    </Border>
</Window>
