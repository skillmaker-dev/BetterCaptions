<Window x:Class="CsOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CsOverlay"
        Width="320"
        Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Caption typography. The caption text is word-wrapped in code into rows and
             each row is a separate TextBlock, so every row is already a single line:
             NoWrap and NO trimming (there is no ellipsis/truncation anywhere). Each row
             paints its own fitted bar. All rows share one font size and line height; only
             the colour tier differs (bottom row brightest). -->
        <Style x:Key="CaptionBase" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- Pin the line box to LineHeight exactly so a 3-row window trims whole
                 rows only; the row height is LineHeight plus the bar padding below. -->
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <!-- Each row paints its OWN fitted bar: the element's size is the text plus
                 this padding, so the bar width is scoped to its own row. The vertical
                 padding is deliberately small (2) so the bar hugs the glyphs. -->
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Padding" Value="10,2" />
            <!-- Centred within the vertical stack, so a shorter row sits centred under a
                 longer one (the long bar / short bar look). -->
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- One already-wrapped caption row. Font size, line height and brush are applied
             per row in code so all rows are the SAME size and only the colour tier
             differs (the bottom/newest row is brightest, rows above are dimmer). -->
        <Style x:Key="CaptionRow" TargetType="TextBlock" BasedOn="{StaticResource CaptionBase}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <!-- The fitted-bar treatment for the no-caption hint, so that with the
             transparent container no text floats unbacked over the game. -->
        <Style x:Key="StatusBar" TargetType="TextBlock">
            <Setter Property="Background" Value="#8C000000" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <!-- The container is visually transparent - each caption row paints its own fitted
         #8C000000 bar instead. A Transparent brush paints nothing but stays hit-testable,
         which is what keeps the panel draggable.
         Width is not set: the slab auto-fits to the widest VISIBLE row (bounded by
         MinWidth/MaxWidth in code). Height is floored by MinHeight, which is the fixed
         3-row window, so the panel stops resizing as captions change; rows fill from the
         bottom and unused rows are collapsed (they paint no bar). -->
    <Border x:Name="OverlayPanel"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseLeftButtonDown="OverlayPanel_MouseLeftButtonDown"
            MouseMove="OverlayPanel_MouseMove"
            MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp"
            MouseEnter="OverlayPanel_MouseEnter"
            MouseLeave="OverlayPanel_MouseLeave">
        <Grid>
            <!-- No padding: each line carries its own, so the group width is exactly
                 the widest bar and no bar edge is clipped. -->
            <Border x:Name="CaptionArea"
                    Padding="0">
                <Grid ClipToBounds="True">
                    <!-- Up to the configured max row count (_maxDisplayedRows) of
                         already-wrapped rows are added here (oldest first), bottom-aligned
                         so the newest row sits at the bottom. Unused rows are collapsed, so
                         they take no space and paint no bar. -->
                    <StackPanel x:Name="CaptionLinesPanel"
                                VerticalAlignment="Bottom" />

                    <!-- Quiet hint for the no-caption states. -->
                    <TextBlock x:Name="CaptionStatusText"
                               Style="{StaticResource StatusBar}"
                               Text="Live captions starting..."
                               Foreground="#80FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               FontStyle="Italic"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- The width grip. Hidden until the panel is hovered (faded in/out from
                 code-behind) and non-hit-testable while hidden. It adjusts the max-width
                 cap only: the height is the fixed 3-row window, so vertical resizing is
                 meaningless. A plain transparent hit area with a small mark. -->
            <Grid x:Name="ResizeGrips"
                  Opacity="0"
                  IsHitTestVisible="False">

                <Grid x:Name="GripRight"
                      Width="8"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      Cursor="SizeWE"
                      MouseLeftButtonDown="GripRight_MouseLeftButtonDown"
                      MouseMove="Grip_MouseMove"
                      MouseLeftButtonUp="Grip_MouseLeftButtonUp">
                    <Rectangle Width="2" Height="26"
                               RadiusX="1" RadiusY="1"
                               Fill="#4DFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
