<Window x:Class="CsOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CsOverlay Options"
        Width="720"
        Height="780"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FFF4F4F4"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="Foreground" Value="#FF202020" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF303030" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#FF666666" />
        </Style>
        <!-- The live preview of the currently applied colour. -->
        <Style x:Key="PreviewSwatch" TargetType="Border">
            <Setter Property="Height" Value="24" />
            <Setter Property="BorderBrush" Value="#FF7A7A7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <!-- One preset colour. The small square shows the colour it applies. -->
        <Style x:Key="PresetSwatch" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#FF7A7A7A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Width" Value="92" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
        <StackPanel>
            <!-- ============================================================
                 LIVE PREVIEW: renders fixed sample text with the SAME rules
                 the overlay uses (shared wrap + row appearance), over a dark
                 neutral backdrop so the translucent bars read realistically.
                 Display-only: not hit-testable, never affects the overlay.
                 ============================================================ -->
            <TextBlock Text="Preview" Style="{StaticResource SectionHeader}" Margin="0,6,0,6" />

            <Border x:Name="PreviewBackdrop"
                    Height="300"
                    Margin="0,0,0,4"
                    Background="#FF2B2F36"
                    BorderBrush="#FF1A1D22"
                    BorderThickness="1"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
                <Grid>
                    <!-- Random photo backdrop (Lorem Picsum), loaded once, asynchronously.
                         The solid dark Background above is the offline/failure fallback. -->
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" />
                    <!-- A minimal scrim so the caption bars stay fully legible over the photo. -->
                    <Rectangle Fill="#4D000000" />
                    <!-- The rendered caption rows, on top of the photo. The panel auto-fits
                         its width to its content, so this stack is normally narrower than
                         the area and is centred within it. -->
                    <StackPanel x:Name="PreviewRows"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- The existing controls, kept at their established width. -->
            <StackPanel MaxWidth="404" HorizontalAlignment="Left">
                <TextBlock Text="Captions" Style="{StaticResource SectionHeader}" Margin="0,6,0,6" />

                <!-- Text colour: live preview + editable hex + preset swatches. -->
                <StackPanel Margin="0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Text colour" Style="{StaticResource RowLabel}" />
                        <Border x:Name="TextColorPreview" Grid.Column="1" Style="{StaticResource PreviewSwatch}" />
                        <TextBox x:Name="TextHexBox" Grid.Column="2" Style="{StaticResource HexBox}"
                                 KeyDown="TextHexBox_KeyDown"
                                 LostFocus="TextHexBox_LostFocus" />
                    </Grid>
                    <WrapPanel Margin="150,6,0,0">
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFFFFF" Tag="#FFFFFF" ToolTip="White" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF000000" Tag="#000000" ToolTip="Black" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFF0000" Tag="#FF0000" ToolTip="Red" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF008000" Tag="#008000" ToolTip="Green" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF0000FF" Tag="#0000FF" ToolTip="Blue" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFFF00" Tag="#FFFF00" ToolTip="Yellow" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF00FFFF" Tag="#00FFFF" ToolTip="Cyan" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFF00FF" Tag="#FF00FF" ToolTip="Magenta" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFA500" Tag="#FFA500" ToolTip="Orange" Click="TextPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF808080" Tag="#808080" ToolTip="Mid grey" Click="TextPreset_Click" />
                    </WrapPanel>
                </StackPanel>

                <!-- Background colour: same editor. Alpha is owned by the slider below. -->
                <StackPanel Margin="0,8,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Background colour" Style="{StaticResource RowLabel}" />
                        <Border x:Name="BackgroundColorPreview" Grid.Column="1" Style="{StaticResource PreviewSwatch}" />
                        <TextBox x:Name="BackgroundHexBox" Grid.Column="2" Style="{StaticResource HexBox}"
                                 KeyDown="BackgroundHexBox_KeyDown"
                                 LostFocus="BackgroundHexBox_LostFocus" />
                    </Grid>
                    <WrapPanel Margin="150,6,0,0">
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFFFFF" Tag="#FFFFFF" ToolTip="White" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF000000" Tag="#000000" ToolTip="Black" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFF0000" Tag="#FF0000" ToolTip="Red" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF008000" Tag="#008000" ToolTip="Green" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF0000FF" Tag="#0000FF" ToolTip="Blue" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFFF00" Tag="#FFFF00" ToolTip="Yellow" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF00FFFF" Tag="#00FFFF" ToolTip="Cyan" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFF00FF" Tag="#FF00FF" ToolTip="Magenta" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FFFFA500" Tag="#FFA500" ToolTip="Orange" Click="BackgroundPreset_Click" />
                        <Button Style="{StaticResource PresetSwatch}" Background="#FF808080" Tag="#808080" ToolTip="Mid grey" Click="BackgroundPreset_Click" />
                    </WrapPanel>
                </StackPanel>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background opacity" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="BackgroundAlphaSlider" Grid.Column="1"
                            Minimum="0" Maximum="255"
                            VerticalAlignment="Center"
                            ValueChanged="BackgroundAlphaSlider_ValueChanged" />
                    <TextBlock x:Name="BackgroundAlphaValue" Grid.Column="2" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gap" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="GapSlider" Grid.Column="1"
                            Minimum="0" Maximum="30"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="GapSlider_ValueChanged" />
                    <TextBlock x:Name="GapValue" Grid.Column="2" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font size" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="FontSizeSlider" Grid.Column="1"
                            Minimum="12" Maximum="40"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="FontSizeSlider_ValueChanged" />
                    <TextBlock x:Name="FontSizeValue" Grid.Column="2" Style="{StaticResource RowValue}" />
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max rows" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="MaxRowsSlider" Grid.Column="1"
                            Minimum="1" Maximum="10"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="MaxRowsSlider_ValueChanged" />
                    <TextBlock x:Name="MaxRowsValue" Grid.Column="2" Style="{StaticResource RowValue}" />
                </Grid>

                <CheckBox x:Name="CenterTextCheck" Content="Center text" Margin="0,10,0,0"
                          Checked="CenterTextCheck_Changed" Unchecked="CenterTextCheck_Changed" />

                <TextBlock Text="Panel" Style="{StaticResource SectionHeader}" />

                <CheckBox x:Name="CenterPanelCheck" Content="Center panel on screen" Margin="0,2,0,0"
                          Checked="CenterPanelCheck_Changed" Unchecked="CenterPanelCheck_Changed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
